{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mbn-theme/mission-section",
  "title": "Mission Section",
  "category": "mbn-blocks",
  "icon": "shield",
  "description": "Mission section with images, text blocks, and center shield icon",
  "textdomain": "mbn-theme",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "backgroundImageUrl": {
      "type": "string",
      "default": ""
    },
    "backgroundImageId": {
      "type": "number",
      "default": 0
    },
    "topHeading": {
      "type": "string",
      "default": "Our mission is clearcut. To provide elite-level protective services, safety training and emergency readiness resources to at-risk individuals and institutions - regardless of their ability to pay."
    },
    "topHeadingMaxWidth": {
      "type": "string",
      "default": "max-w-4xl"
    },
    "topHeadingAlignment": {
      "type": "string",
      "default": "center"
    },
    "middleContentLayout": {
      "type": "string",
      "default": "grid",
      "enum": ["grid", "image-only", "image-text"]
    },
    "middleImageUrl": {
      "type": "string",
      "default": ""
    },
    "middleImageId": {
      "type": "number",
      "default": 0
    },
    "middleImageAlt": {
      "type": "string",
      "default": ""
    },
    "middleItems": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "leftText": {
      "type": "string",
      "default": "Those who serve should never be left unprotected. We partner with licensed, carefully vetted security professionals,"
    },
    "leftImageUrl": {
      "type": "string",
      "default": ""
    },
    "leftImageId": {
      "type": "number",
      "default": 0
    },
    "leftImageAlt": {
      "type": "string",
      "default": ""
    },
    "rightText": {
      "type": "string",
      "default": "including both armed and unarmed protective personnel, as well as highly experienced security trainers."
    },
    "rightImageUrl": {
      "type": "string",
      "default": ""
    },
    "rightImageId": {
      "type": "number",
      "default": 0
    },
    "rightImageAlt": {
      "type": "string",
      "default": ""
    },
    "centerIconUrl": {
      "type": "string",
      "default": ""
    },
    "centerIconId": {
      "type": "number",
      "default": 0
    },
    "centerIconAlt": {
      "type": "string",
      "default": ""
    },
    "bottomText": {
      "type": "string",
      "default": "We bring serious, effective protection capabilities to innocent people who would otherwise go unprotected. <em>We are the line in the sand.</em>"
    },
    "bottomTextMaxWidth": {
      "type": "string",
      "default": "max-w-4xl"
    },
    "bottomTextAlignment": {
      "type": "string",
      "default": "center"
    },
    "align": {
      "type": "string",
      "default": "full"
    },
    "animationType": {
      "type": "string",
      "default": ""
    },
    "animationDuration": {
      "type": "string",
      "default": ""
    },
    "animationDelay": {
      "type": "number",
      "default": 0
    }
  },
  "example": {},
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "viewScript": "file:./script.js",
  "render": "file:./render.php"
}
