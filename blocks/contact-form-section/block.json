{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mbn-theme/contact-form-section",
  "title": "Contact Form Section",
  "category": "mbn-blocks",
  "icon": "feedback",
  "description": "Contact form section with background image, Gravity Forms integration, and footer note",
  "textdomain": "mbn-theme",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "backgroundImageUrl": {
      "type": "string",
      "default": ""
    },
    "backgroundImageId": {
      "type": "number",
      "default": 0
    },
    "formShortcode": {
      "type": "string",
      "default": "[gravityform id=\"1\" title=\"false\" description=\"false\"]"
    },
    "footerNote": {
      "type": "string",
      "default": "For large gifts, institutional partnerships, or media requests, please include as much detail as possible so we can direct your inquiry appropriately."
    },
    "align": {
      "type": "string",
      "default": "full"
    },
    "animationType": {
      "type": "string",
      "default": ""
    },
    "animationDuration": {
      "type": "string",
      "default": ""
    },
    "animationDelay": {
      "type": "number",
      "default": 0
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
